{
  "name": "pi-remote-ios",
  "version": "0.1.0",
  "description": "Pi extension, LAN hub and native iOS companion for controlling Pi coding-agent sessions on your Mac from an iPhone.",
  "license": "MIT",
  "author": "Tornike Gomareli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tornikegomareli/pi-remote-ios.git"
  },
  "homepage": "https://github.com/tornikegomareli/pi-remote-ios#readme",
  "bugs": {
    "url": "https://github.com/tornikegomareli/pi-remote-ios/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "ios",
    "swiftui",
    "remote-control",
    "websocket",
    "coding-agent"
  ],
  "files": [
    "extension",
    "hub",
    "docs/assets",
    "docs/PROTOCOL.md",
    "docs/SECURITY.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "pi-remote-hub": "hub/bin.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tornikegomareli/pi-remote-ios/main/docs/assets/pi-remote-hero.webp"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.15.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "typebox": "1.3.27",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.1"
  }
}
